{
  "name": "dshmux",
  "displayName": "DSHmux",
  "description": "Launch DeepSeek Harness and embed its Web UI inside VS Code & Antigravity — side-panel chat, editor-tab view, shared browser state, sounds, clipboard, and theme sync.",
  "version": "0.3.6",
  "publisher": "matik5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matik5/DSHmux.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "dshmux.dshPath"
      ]
    }
  },
  "files": [
    "out/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.zh.md",
    "media/icon.png",
    "node_modules/ws/**",
    "CHANGELOG.md",
    "CHANGELOG.zh.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dshmux.start",
        "title": "%command.start.title%",
        "category": "DSHmux"
      },
      {
        "command": "dshmux.stop",
        "title": "%command.stop.title%",
        "category": "DSHmux"
      },
      {
        "command": "dshmux.openBrowser",
        "title": "%command.openBrowser.title%",
        "category": "DSHmux"
      },
      {
        "command": "dshmux.openPanel",
        "title": "%command.openPanel.title%",
        "category": "DSHmux"
      }
    ],
    "configuration": {
      "title": "DSHmux",
      "properties": {
        "dshmux.dshPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%setting.dshPath.description%"
        },
        "dshmux.themeSync": {
          "type": "string",
          "enum": [
            "follow",
            "off"
          ],
          "default": "follow",
          "description": "%setting.themeSync.description%"
        },
        "dshmux.completionSound": {
          "type": "boolean",
          "default": true,
          "description": "%setting.completionSound.description%"
        },
        "dshmux.frameFontScale": {
          "type": "number",
          "default": 0.9,
          "minimum": 0.5,
          "maximum": 1.5,
          "description": "%setting.frameFontScale.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshmux",
          "title": "DSHmux",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dshmux": [
        {
          "type": "webview",
          "id": "dshmux.view",
          "name": "DSHmux"
        },
        {
          "type": "webview",
          "id": "dshmux.chat",
          "name": "%view.chat.name%",
          "icon": "media/icon.svg",
          "description": "%view.chat.description%"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "tsc -p ./ && node --test"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "dshmux",
    "deepseek-harness",
    "deepseek",
    "ai-agent",
    "coding-agent",
    "vscode",
    "webview",
    "antigravity",
    "ide",
    "harness"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
