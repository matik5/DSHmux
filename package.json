{
  "name": "dshmux",
  "displayName": "DSHmux",
  "description": "Launch DeepSeek Harness and embed its Web UI inside VS Code & Antigravity — side-panel chat, editor-tab view, shared browser state, sounds, clipboard, and theme sync.",
  "version": "0.4.8",
  "publisher": "matik5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matik5/DSHmux.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "dshmux.dshPath"
      ]
    }
  },
  "files": [
    "out/**",
    "media/**",
    "runtime/**",
    "README.md",
    "LICENSE",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.zh.md",
    "media/icon.png",
    "node_modules/ws/**",
    "CHANGELOG.md",
    "CHANGELOG.zh.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dshmux.start",
        "title": "%command.start.title%",
        "category": "DSHmux"
      },
      {
        "command": "dshmux.stop",
        "title": "%command.stop.title%",
        "category": "DSHmux"
      },
      {
        "command": "dshmux.openBrowser",
        "title": "%command.openBrowser.title%",
        "category": "DSHmux"
      },
      {
        "command": "dshmux.openPanel",
        "title": "%command.openPanel.title%",
        "category": "DSHmux"
      },
      {
        "command": "dshmux.doctor",
        "title": "%command.doctor.title%",
        "category": "DSHmux"
      }
    ],
    "configuration": [
      {
        "title": "DSHmux",
        "order": 10,
        "properties": {
          "dshmux.dshPath": {
            "type": "string",
            "default": "",
            "scope": "machine-overridable",
            "description": "%setting.dshPath.description%"
          },
          "dshmux.themeSync": {
            "type": "string",
            "enum": [
              "follow",
              "off"
            ],
            "default": "follow",
            "description": "%setting.themeSync.description%"
          },
          "dshmux.frameFontScale": {
            "type": "number",
            "default": 0.9,
            "minimum": 0.5,
            "maximum": 1.5,
            "description": "%setting.frameFontScale.description%"
          }
        }
      },
      {
        "title": "%configuration.feedbackSounds.title%",
        "order": 20,
        "properties": {
          "dshmux.completionSound": {
            "type": "boolean",
            "default": true,
            "order": 10,
            "description": "%setting.completionSound.description%"
          },
          "dshmux.soundStart": {
            "type": "boolean",
            "default": true,
            "order": 20,
            "description": "%setting.soundStart.description%"
          },
          "dshmux.soundDone": {
            "type": "boolean",
            "default": true,
            "order": 30,
            "description": "%setting.soundDone.description%"
          },
          "dshmux.soundAsk": {
            "type": "boolean",
            "default": true,
            "order": 40,
            "description": "%setting.soundAsk.description%"
          }
        }
      },
      {
        "title": "%configuration.experimental.title%",
        "order": 30,
        "properties": {
          "dshmux.experimental.localDictation.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "machine",
            "order": 100,
            "description": "%setting.localDictation.enabled.description%"
          },
          "dshmux.experimental.localDictation.language": {
            "type": "string",
            "enum": [
              "en-US",
              "et-EE"
            ],
            "default": "en-US",
            "scope": "machine",
            "order": 110,
            "description": "%setting.localDictation.language.description%"
          },
          "dshmux.experimental.localDictation.hostPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 120,
            "description": "%setting.localDictation.hostPath.description%"
          },
          "dshmux.experimental.localDictation.audioDevice": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 130,
            "description": "%setting.localDictation.audioDevice.description%"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshmux",
          "title": "DSHmux",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dshmux": [
        {
          "type": "webview",
          "id": "dshmux.chat",
          "name": "%view.chat.name%"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "tsc -p ./ && node --test"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "dshmux",
    "deepseek-harness",
    "deepseek",
    "ai-agent",
    "coding-agent",
    "vscode",
    "webview",
    "antigravity",
    "ide",
    "harness"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
